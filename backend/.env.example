# CircuitDoctor Environment Configuration
PROJECT_NAME=CircuitDoctor
API_V1_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage & Paths
DATABASE_URL=sqlite:///./circuitdoctor.db
UPLOAD_DIR=./uploads
ANNOTATED_DIR=./annotated
REPORTS_DIR=../reports
MODEL_PATH=../models/best.pt

# Inference Defaults
DEFAULT_CONFIDENCE_THRESHOLD=0.25
DEFAULT_IOU_THRESHOLD=0.45
MAX_IMAGE_SIZE_MB=25
